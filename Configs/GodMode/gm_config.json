  "radio_channels": {
    "command_net": {
      "description": "Primary command and control channel for high-level orders and situation reports",
      "callsigns": ["Overlord", "Warlord", "Sunray", "Keystone"],
      "formality": "high"
    },
    "squad_net": {
      "description": "Tactical channel for squad-level communication and coordination",
      "callsigns": ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"],
      "formality": "medium"
    },
    "enemy_intercept": {
      "description": "Intercepted enemy communications providing intelligence and atmosphere",
      "callsigns": ["Krasny", "Sokol", "Buran", "Shtorm"],
      "formality": "high"
    },
    "support_net": {
      "description": "Fire support and logistics coordination channel",
      "callsigns": ["Hammer", "Anvil", "Dustoff", "Longbow", "Dealer"],
      "formality": "high"
    }
