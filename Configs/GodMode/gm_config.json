  "pacing": {
    "min_quiet_between_contacts_seconds": 180,
    "max_quiet_between_contacts_seconds": 480,
    "min_contact_duration_seconds": 120,
    "max_sustained_crisis_seconds": 180,
    "escalation_rate": 0.15,
    "deescalation_rate": 0.25,
    "tension_floor": 0.05,
    "tension_ceiling": 1.0
  },
  "mission_engine": {
    "enabled": true,
    "default_archetype": "patrol_ambush",
    "escalation_curve": "standard_bell",
    "max_mission_duration_seconds": 3600,
    "auto_chain_missions": true,
    "auto_scenario_selection": true,
    "default_scenario": "morning_patrol",
    "scenario_rotation": [
      "morning_patrol",
      "convoy_gauntlet",
      "night_recon",
      "last_stand",
      "collision_course",
      "the_hunt"
    ],
    "mission_transition_delay_seconds": 120,
    "max_minefields": 5,
    "max_mines_per_field": 12
  },
  "alert_levels": {
    "green": {
      "description": "Peacetime posture. Minimal threat expected. Routine patrols and standard readiness.",
      "spawn_multiplier": 0.5
    },
    "yellow": {
      "description": "Elevated awareness. Possible threat detected. Increased patrol frequency and observation.",
      "spawn_multiplier": 0.75
    },
    "orange": {
      "description": "High alert. Confirmed enemy activity in area. Defensive positions manned, reserves on standby.",
      "spawn_multiplier": 1.0
    },
    "red": {
      "description": "Active combat. Engagement underway or imminent. Full mobilization, all assets committed.",
      "spawn_multiplier": 1.5
    }
  },
  "weather_moods": {
    "dread": {
      "weather": "Foggy",
      "time_preference": "pre_dawn",
      "wind": "still",
      "narrative_tone": "Thick fog blankets the landscape. Visibility is near zero. Every sound is amplified in the silence."
    },
    "fury": {
      "weather": "Storm",
      "time_preference": "night",
      "wind": "strong_gusting",
      "narrative_tone": "Thunder masks gunfire. Rain hammers down in sheets. Lightning briefly illuminates the chaos."
    },
    "calm_before": {
      "weather": "Clear",
      "time_preference": "early_morning",
      "wind": "light_breeze",
      "narrative_tone": "An unsettling stillness hangs in the air. The sky is clear, the wind gentle. It feels wrong."
    },
    "aftermath": {
      "weather": "Overcast",
      "time_preference": "late_afternoon",
      "wind": "moderate",
      "narrative_tone": "Grey skies press down on the scarred terrain. Smoke drifts lazily from smoldering wreckage."
    },
    "hope": {
      "weather": "Clear",
      "time_preference": "sunrise",
      "wind": "calm",
      "narrative_tone": "Golden light spills across the horizon. For a moment, the war feels distant and unreal."
    },
    "isolation": {
      "weather": "Overcast",
      "time_preference": "midnight",
      "wind": "cold_steady",
      "narrative_tone": "Heavy clouds blot out the stars. The darkness is absolute. You are alone with the wind."
    }
  },
  "command_types": {
    "movement_combat": ["move", "attack", "defend", "patrol", "set_ambush", "seek_and_destroy", "retreat", "order_formation"],
    "spawning": ["spawn_infantry", "spawn_vehicle", "spawn_reinforcements", "spawn_convoy"],
    "environment": ["set_weather", "set_time", "set_wind", "thunder_near", "play_sound"],
    "effects": ["explosion", "smoke", "flare"],
    "fire_support": ["mortar_strike", "air_support"],
    "logistics": ["supply_drop"],
    "fortification": ["establish_checkpoint", "lay_mines", "set_roadblock"],
    "cleanup": ["cleanup_area", "cleanup_dead", "despawn_unit"],
    "narrative": ["radio_message", "objective_create", "objective_complete", "objective_fail", "spawn_marker"],
    "meta": ["set_alert_level", "start_scenario", "end_scenario"]
  },
