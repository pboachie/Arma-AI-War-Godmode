  "middleware": {
    "url": "http://localhost:8000",
    "health_endpoint": "/health",
    "rcon_relay": {
      "enabled": false,
      "address": "127.0.0.1",
      "port": 19999,
      "permission": "admin"
    }
  },
  "server": {
    "max_players": 124,
    "ai_limit": -1,
    "view_distance": 2500,
    "network_view_distance": 2500,
    "disable_third_person": true,
    "battlEye": true,
    "player_save_time_seconds": 120,
    "slot_reservation_timeout_seconds": 60,
    "join_queue_max_size": 12,
    "supported_platforms": ["PLATFORM_PC", "PLATFORM_XBL"],
    "region": "US-LA"
