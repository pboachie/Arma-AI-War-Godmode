  "persistence": {
    "auto_save_interval_minutes": 5,
    "save_player_state": true,
    "save_mission_state": true,
    "save_world_state": false,
    "max_save_slots": 10
  },
  "a2s_query": {
    "enabled": true,
    "port": 17777,
    "expose_player_list": true,
    "expose_mod_list": true
  },
  "llm": {
    "provider": "glm",
    "model": "glm-4.7",
    "max_tokens": 128000,
    "temperature": 0.8,
    "max_history": 100,
    "fallback_provider": "",
    "fallback_model": "",
    "max_concurrent_calls": 10,
    "circuit_breaker_threshold": 3,
    "circuit_breaker_cooldown_seconds": 60,
    "compaction_threshold_messages": 30,
    "compaction_keep_recent": 6
  },
  "rate_limiting": {
    "manual_commands_per_second": 2,
    "manual_commands_burst": 10,
    "sitrep_min_interval_seconds": 5
