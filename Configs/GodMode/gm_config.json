  "logging": {
    "level": "INFO",
    "format": "structured",
    "log_sitrep_payloads": false,
    "log_llm_responses": false,
    "max_command_log_entries": 200
  },
  "replay": {
    "enabled": true,
    "directory": "replays",
    "compress": true,
    "max_file_size_mb": 50
  },
  "performance": {
    "response_time_warning_ms": 5000,
    "response_time_critical_ms": 15000,
    "max_response_time_samples": 100,
    "empty_response_alert_threshold_pct": 10
