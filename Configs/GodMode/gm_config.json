  },
  "escalation_curves": ["standard_bell", "slow_burn", "wave_assault", "ambush_spike", "rolling_thunder"],
  "mission_archetypes": ["patrol_ambush", "convoy_escort", "area_denial", "search_destroy", "vip_extraction", "fob_defense", "recon", "counter_attack", "meeting_engagement"],
  "von_settings": {
    "disable_ui": false,
    "disable_direct_speech_ui": false,
    "cross_faction_transmit": false,
    "proximity_range_meters": 50,
    "radio_range_meters": 3000
