  "game_master": {
    "update_interval_seconds": 30,
    "llm_enabled": true,
    "max_ai_squads": 30,
    "max_vehicles": 20,
    "max_dead_bodies": 30,
    "body_cleanup_delay_seconds": 180,
    "wreck_cleanup_delay_seconds": 300,
    "player_safe_cleanup_radius_meters": 100,
    "navmesh_streaming": true,
    "lobby_sync": true
  },
  "scaling": {
    "0_players": { "max_squads": 10, "max_vehicles": 5, "update_interval": 30 },
    "1-4_players": { "max_squads": 15, "max_vehicles": 8, "update_interval": 30 },
    "5-12_players": { "max_squads": 30, "max_vehicles": 15, "update_interval": 45 },
    "13-32_players": { "max_squads": 50, "max_vehicles": 20, "update_interval": 60 },
    "33-64_players": { "max_squads": 70, "max_vehicles": 30, "update_interval": 75 },
    "65+_players": { "max_squads": 90, "max_vehicles": 40, "update_interval": 90 },
    "performance_aware": true,
    "zone_based": true,
    "team_coordination_scaling": true,
    "ai_limit_scaling": {
      "enabled": true,
      "min_ai_per_player": 3,
      "max_ai_per_player": 8,
      "performance_headroom_pct": 20
    }
  },
  "weather_ids": ["Clear", "Cloudy", "Overcast", "Rainy", "Storm", "Foggy"],
