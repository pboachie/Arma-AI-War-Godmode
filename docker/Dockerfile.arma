# Arma Reforger Dedicated Server
# Modeled on soda3x/docker-reforger-server
FROM debian:bullseye-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        lib32stdc++6 \
        lib32gcc-s1 \
        wget \
        ca-certificates \
        libcurl4 \
        net-tools \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -d /home/reforger -s /bin/bash reforger

RUN mkdir -p \
    /home/reforger/steamcmd \
    /home/reforger/configs \
    /home/reforger/profile \
    /home/reforger/workshop \
    /home/reforger/reforger_bins

RUN wget -qO /tmp/steamcmd_linux.tar.gz \
        https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz && \
    tar -xzf /tmp/steamcmd_linux.tar.gz -C /home/reforger/steamcmd && \
    rm /tmp/steamcmd_linux.tar.gz

COPY launch.py /home/reforger/launch.py
RUN chown -R reforger:reforger /home/reforger

USER reforger
WORKDIR /home/reforger

EXPOSE 2001/udp 17777/udp 19999/udp

ENTRYPOINT ["python3", "/home/reforger/launch.py"]
