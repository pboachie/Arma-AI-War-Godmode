# Root Compose deployment. The VPS installer creates middleware/.env with
# distinct random keys. If creating it yourself, use mode 0600 and two
# different random values, each 32–128 characters (letters, digits, _ or -).
GODMODE_API_KEY=
GODMODE_GAME_API_KEY=

# TCP port on the Docker host's 127.0.0.1 only. Use SSH forwarding to reach it remotely.
GODMODE_PORT=8080

# Optional basemap preset. Set to everon only when the game uses the Eden/Everon terrain.
# GODMODE_DASHBOARD_MAP=everon

# Optional raw game telemetry. See docs/OPERATIONS.md for retention and privacy.
# GODMODE_RECORD_REPLAYS=false

# disabled makes no external LLM calls. Explicit alternatives are anthropic,
# openai, glm, openrouter and ollama. Enable just the provider you intend to use.
LLM_PROVIDER=disabled
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GLM_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/
# GLM_TEMPERATURE=0.8
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OLLAMA_BASE_URL=http://your-ollama-host:11434
# LLM_MODEL=
# FALLBACK_PROVIDER=
# FALLBACK_MODEL=

# Optional runtime tuning.
# LLM_MAX_TOKENS=2000
# LLM_RATE_LIMIT_RPM=20
# AGENTS_ENABLED=false
# MAX_HISTORY=20
# MAX_CONCURRENT_LLM=2
# MAX_MEMORY_MESSAGES=20
# MEMORY_TOKEN_LIMIT=32000
# COMPACTION_THRESHOLD=12

# Public deployment keeps RCON and server control off, and CORS empty.
# These settings are fixed in root compose.yml, not configurable here.
# The installer ignores exported Compose/application variables. For direct
# docker compose commands, shell variables can override file settings.
