# ═══════════════════════════════════════════════
# Arma Reforger God Mode — Environment Config
# ═══════════════════════════════════════════════
# Copy this to .env and fill in your values.
#
# Pick ONE provider section below and fill in its key.
# The LLM_PROVIDER value determines which key is used.

# ── Provider Selection ──
# Options: "anthropic", "openai", "glm", "ollama"
LLM_PROVIDER=anthropic

# ── Anthropic (Claude) ──
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── OpenAI (GPT) ──
# OPENAI_API_KEY=sk-your-key-here

# ── Z.AI GLM (Coding endpoint) ──
# Get your key at https://open.z.ai/
# GLM_API_KEY=your-glm-key-here
#
# Endpoint options:
#   Coding (default): https://api.z.ai/api/coding/paas/v4/
#   General:          https://api.z.ai/api/paas/v4/
# GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/
#
# Temperature for GLM (0.0–1.0, default 0.8)
# GLM_TEMPERATURE=0.8

# ── Ollama (local models, no API key needed) ──
# OLLAMA_BASE_URL=http://localhost:11434

# ── Model Override ──
# Leave unset to use provider defaults:
#   anthropic → claude-sonnet-4-20250514
#   openai    → gpt-4o
#   glm       → glm-4.7
#   ollama    → llama3.1
# LLM_MODEL=glm-4.7

# ── Fallback Provider ──
# If the primary provider fails, automatically try a fallback.
# FALLBACK_PROVIDER=openai
# FALLBACK_MODEL=gpt-4o

# ── General Settings ──
# Max response tokens per LLM call
LLM_MAX_TOKENS=2000

# How many SITREP snapshots to keep in rolling history
MAX_HISTORY=20

# ── Memory Settings (LangChain) ──
# Max conversation message pairs to keep per session
MAX_MEMORY_MESSAGES=100

# Token budget for memory context
MEMORY_TOKEN_LIMIT=128000

# ── Auto-Compaction ──
# After this many messages, old memory is compressed into a strategic briefing
# via an extra LLM call. Lower = more frequent compaction (uses tokens).
# Set very high to disable (e.g. 9999).
COMPACTION_THRESHOLD=12

# ── Arma Reforger Server ──
ARMA_SERVER_NAME=AI War [100% LLM-Managed]
ARMA_ADMIN_PASSWORD=changeme
ARMA_RCON_PASSWORD=changeme_rcon
# Dedicated-server bind address used in config generation
ARMA_RCON_BIND_ADDRESS=0.0.0.0
# Middleware connection targets (localhost for non-Docker runs)
ARMA_RCON_ADDRESS=127.0.0.1
ARMA_A2S_ADDRESS=127.0.0.1
ARMA_RCON_PORT=19999
ARMA_GAME_PORT=2001
ARMA_A2S_PORT=17777
ARMA_MAX_PLAYERS=124
ARMA_SCENARIO_ID=ECC61978EDCC2B5A
ARMA_SERVER_DIR=/home/reforger/reforger_bins

# ── Local Addon Staging (Docker) ──
# These folders are mounted into the Arma container and copied into the
# server's local addon search path on startup.
ARMA_LOCAL_ADDON_ENABLED=true
ARMA_LOCAL_ADDON_NAME=GodMode
ARMA_LOCAL_ADDON_ID=GodMode
ARMA_LOCAL_SCRIPTS_SOURCE=../scripts/Game
ARMA_LOCAL_CONFIGS_SOURCE=../Configs
# Windows example:
# ARMA_LOCAL_SCRIPTS_SOURCE=D:/MyPC/AI War/scripts/Game
# ARMA_LOCAL_CONFIGS_SOURCE=D:/MyPC/AI War/Configs

# ── Security ──
# API key for dashboard and admin endpoints (leave empty to disable auth)
GODMODE_API_KEY=
# CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*
